# ============================================================================
# Email Delivery Platform - frontend environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Vite embeds these at build time - change + redeploy to update.
# ============================================================================

# URL of the deployed backend API (no trailing slash)
# In local development this can be left unset - the Vite dev proxy serves /api.
VITE_API_URL=https://email-delivery-platform.onrender.com/api
