# ============================================================================
# Email Delivery Platform - backend environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Server ----------------------------------------------------------------
PORT=5000
SPRING_PROFILES_ACTIVE=prod

# --- Database (PostgreSQL) -------------------------------------------------
# Option 1 (recommended for Render/Neon/Railway): single connection string
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/emailplatform?sslmode=require
# Option 2: individual JDBC settings (uncomment and comment out DATABASE_URL)
# DB_URL=jdbc:postgresql://HOST:5432/emailplatform
# DB_USERNAME=emailplatform
# DB_PASSWORD=change-me
# DB_DDL_AUTO=validate
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- JWT -------------------------------------------------------------------
# Generate a strong value, e.g.  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRATION_MS=604800000

# --- Application -----------------------------------------------------------
APP_BASE_URL=https://email-delivery-platform.onrender.com
# Admin bootstrap account (created on first startup by DataSeeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Comma-separated list of allowed browser origins (frontend domains)
CORS_ALLOWED_ORIGINS=https://email-delivery-platform.vercel.app,http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Mail (SMTP) -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_CONNECTION_TIMEOUT=5000
SMTP_TIMEOUT=5000
SMTP_WRITE_TIMEOUT=5000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_LEVEL_ROOT=INFO
